<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Learn Numbers</title>
<link rel="stylesheet" href="styles.css">
<style>
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:1rem;}
.number-box{
  background:#e6ee9c;border-radius:10px;
  height:80px;display:flex;align-items:center;justify-content:center;
  font-size:2rem;font-weight:bold;cursor:pointer;
}
</style>
</head>
<body>
  <div class="container">
    <h1>Learn Numbers 🔢</h1>
    <div class="grid" id="nums"></div>
    <br><a href="dashboard.html" class="menu-btn">⬅ Back</a>
  </div>

  <script>// Auto progress +10% when visiting
const profiles=JSON.parse(localStorage.getItem('profiles'))||[];
const i=localStorage.getItem('activeProfile');
if(profiles[i]){
  profiles[i].progress=Math.min((profiles[i].progress||0)+10,100);
  localStorage.setItem('profiles',JSON.stringify(profiles));
}
    const nums=document.getElementById('nums');
    for(let n=0;n<=20;n++){
      nums.innerHTML += `<div class="number-box" onclick="say(${n})">${n}</div>`;
    }
    function say(num){new Audio(`sounds/${num}.mp3`).play();}
  </script>
</body>
</html>